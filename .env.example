# No secrets in the browser. Supabase keys + admin login live in `backend/.env` (loaded by Next via `next.config.mjs` — see `backend/.env.example`).

# Optional: API origin if the frontend is hosted separately (no trailing slash; do NOT append /api).
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Optional: canonical site URL for SEO helpers (`src/seo/siteInfo.ts`).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
